{
  "name": "mdello",
  "private": true,
  "packageManager": "yarn@4.12.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspace @mdello/client dev",
    "build:client": "yarn workspace @mdello/client build",
    "build:pi-extension": "yarn workspace @mdello/pi-extension build",
    "build:opencode-extension": "yarn workspace @mdello/opencode-extension build",
    "build": "yarn build:client && yarn build:pi-extension && yarn build:opencode-extension",
    "companion": "yarn workspace mdello-companion start",
    "format": "biome check --write .",
    "lint": "biome check .",
    "preview": "yarn workspaces foreach -A run preview",
    "test": "yarn workspaces foreach -A -p run test",
    "typecheck": "yarn workspaces foreach -A -p run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9"
  }
}
