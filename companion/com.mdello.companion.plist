<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mdello.companion</string>

  <key>ProgramArguments</key>
  <array>
    <string>__MISE_BIN__</string>
    <string>exec</string>
    <string>--</string>
    <string>node</string>
    <string>--experimental-strip-types</string>
    <string>companion/cli.ts</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__MDELLO_ROOT__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>MDELLO_COMPANION_PORT</key>
    <string>31337</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__HOME__/.mdello/companion.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.mdello/companion-error.log</string>
</dict>
</plist>
