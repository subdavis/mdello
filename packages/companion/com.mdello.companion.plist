<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mdello.companion</string>

  <!-- Absolute node path, resolved at install time. launchd execs this binary directly so the
       process macOS attributes privacy grants to is stable and visible in the plist. -->
  <key>ProgramArguments</key>
  <array>
    <string>__NODE_BIN__</string>
    <string>--experimental-strip-types</string>
    <string>packages/companion/src/cli.ts</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__MDELLO_ROOT__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>MDELLO_COMPANION_PORT</key>
    <string>31337</string>
    <!-- launchd does not source shell rc files; without this, only /usr/bin:/bin:/usr/sbin:/sbin
         is visible, so CLIs installed under ~/.local/bin, Homebrew, mise, etc. (e.g. herdr) can't
         be found. Baked in at install time from the installing shell's own PATH. -->
    <key>PATH</key>
    <string>__PATH__</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__HOME__/.mdello/companion.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.mdello/companion-error.log</string>
</dict>
</plist>
