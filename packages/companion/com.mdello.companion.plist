<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mdello.companion</string>

  <!-- Absolute node path, resolved at install time. launchd execs this binary directly so the
       process macOS attributes privacy grants to is stable and visible in the plist. -->
  <key>ProgramArguments</key>
  <array>
    <string>__NODE_BIN__</string>
    <string>--experimental-strip-types</string>
    <string>packages/companion/src/cli.ts</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__MDELLO_ROOT__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>MDELLO_COMPANION_PORT</key>
    <string>51618</string>
    <key>XDG_CONFIG_HOME</key>
    <string>__XDG_CONFIG_HOME__</string>
    <key>XDG_STATE_HOME</key>
    <string>__XDG_STATE_HOME__</string>
__HERDR_ENV__
__GH_ENV__
__JIRA_ENV__
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__COMPANION_STDOUT__</string>
  <key>StandardErrorPath</key>
  <string>__COMPANION_STDERR__</string>
</dict>
</plist>
